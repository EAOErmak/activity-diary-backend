<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1_create_diary_entry_goal" author="you">
        <createTable tableName="diary_entry_goal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="day_goal_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="when_started" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="when_ended" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="expected_duration_min" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>

            <column name="mood" type="SMALLINT"/>
            <column name="description" type="VARCHAR(1000)"/>

            <column name="current_entry_id" type="BIGINT"/>

            <column name="completeness" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="diary_entry_goal" indexName="idx_entry_goal_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="diary_entry_goal" indexName="idx_entry_goal_day">
            <column name="day_goal_id"/>
        </createIndex>
        <createIndex tableName="diary_entry_goal" indexName="idx_entry_goal_range">
            <column name="when_started"/>
            <column name="when_ended"/>
        </createIndex>
        <createIndex tableName="diary_entry_goal" indexName="idx_entry_goal_entry">
            <column name="current_entry_id"/>
        </createIndex>

        <addForeignKeyConstraint constraintName="fk_entry_goal_user"
                                 baseTableName="diary_entry_goal" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"/>

        <addForeignKeyConstraint constraintName="fk_entry_goal_day"
                                 baseTableName="diary_entry_goal" baseColumnNames="day_goal_id"
                                 referencedTableName="day_goal" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint constraintName="fk_entry_goal_current_entry"
                                 baseTableName="diary_entry_goal" baseColumnNames="current_entry_id"
                                 referencedTableName="diary_entry" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
