<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1-42-create-metric-name-unit-link" author="diary">
        <createTable tableName="metric_name_unit_link">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="metric_name_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="metric_unit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="metric_name_unit_link"
                columnNames="metric_name_id, metric_unit_id"
                constraintName="uk_metric_name_unit_link_metric_name_metric_unit"/>

        <createIndex indexName="idx_metric_name_unit_link_metric_name" tableName="metric_name_unit_link">
            <column name="metric_name_id"/>
        </createIndex>

        <createIndex indexName="idx_metric_name_unit_link_metric_unit" tableName="metric_name_unit_link">
            <column name="metric_unit_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="metric_name_unit_link"
                baseColumnNames="metric_name_id"
                referencedTableName="dictionary_item"
                referencedColumnNames="id"
                constraintName="fk_metric_name_unit_link_metric_name"/>

        <addForeignKeyConstraint
                baseTableName="metric_name_unit_link"
                baseColumnNames="metric_unit_id"
                referencedTableName="dictionary_item"
                referencedColumnNames="id"
                constraintName="fk_metric_name_unit_link_metric_unit"/>
    </changeSet>

</databaseChangeLog>
