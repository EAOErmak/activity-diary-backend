<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="v1_create_diary_entry_template_tag" author="you">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="diary_entry_template_tag"/>
            </not>
        </preConditions>

        <createTable tableName="diary_entry_template_tag">
            <column name="template_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="diary_entry_template_tag"
                columnNames="template_id,tag_id"
                constraintName="pk_diary_entry_template_tag"/>

        <addForeignKeyConstraint
                constraintName="fk_det_tag_template"
                baseTableName="diary_entry_template_tag"
                baseColumnNames="template_id"
                referencedTableName="diary_entry_template"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_det_tag_tag"
                baseTableName="diary_entry_template_tag"
                baseColumnNames="tag_id"
                referencedTableName="tag"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex indexName="idx_det_tag_template" tableName="diary_entry_template_tag">
            <column name="template_id"/>
        </createIndex>

        <createIndex indexName="idx_det_tag_tag" tableName="diary_entry_template_tag">
            <column name="tag_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
