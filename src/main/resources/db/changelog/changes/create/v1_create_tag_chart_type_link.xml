<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1-46-create-tag-chart-type-link" author="diary">
        <createTable tableName="tag_chart_type_link">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="chart_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="tag_chart_type_link"
                columnNames="tag_id, chart_type"
                constraintName="uk_tag_chart_type_link_tag_chart_type"/>

        <createIndex indexName="idx_tag_chart_type_link_tag" tableName="tag_chart_type_link">
            <column name="tag_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="tag_chart_type_link"
                baseColumnNames="tag_id"
                referencedTableName="tag"
                referencedColumnNames="id"
                constraintName="fk_tag_chart_type_link_tag"/>
    </changeSet>

</databaseChangeLog>
