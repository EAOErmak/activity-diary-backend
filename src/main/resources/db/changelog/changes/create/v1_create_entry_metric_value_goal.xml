<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1_create_entry_metric_value_goal" author="you">
        <createTable tableName="entry_metric_value_goal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="metric_goal_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="unit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="expected_value" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="entry_metric_value_goal"
                             constraintName="uk_metric_value_goal_metric_unit"
                             columnNames="metric_goal_id,unit_id"/>

        <createIndex tableName="entry_metric_value_goal" indexName="idx_metric_value_goal_metric">
            <column name="metric_goal_id"/>
        </createIndex>
        <createIndex tableName="entry_metric_value_goal" indexName="idx_metric_value_goal_unit">
            <column name="unit_id"/>
        </createIndex>

        <addForeignKeyConstraint constraintName="fk_metric_value_goal_metric"
                                 baseTableName="entry_metric_value_goal" baseColumnNames="metric_goal_id"
                                 referencedTableName="entry_metric_goal" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint constraintName="fk_metric_value_goal_unit"
                                 baseTableName="entry_metric_value_goal" baseColumnNames="unit_id"
                                 referencedTableName="dictionary_item" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
