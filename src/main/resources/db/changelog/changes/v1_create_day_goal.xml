<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1_create_day_goal" author="you">
        <createTable tableName="day_goal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="week_goal_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="day_index" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="target_date" type="DATE"/>

            <column name="when_started" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="when_ended" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="completeness" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="day_goal"
                             constraintName="uk_day_goal_week_day_index"
                             columnNames="week_goal_id,day_index"/>

        <createIndex tableName="day_goal" indexName="idx_day_goal_week">
            <column name="week_goal_id"/>
        </createIndex>
        <createIndex tableName="day_goal" indexName="idx_day_goal_date">
            <column name="target_date"/>
        </createIndex>

        <addForeignKeyConstraint constraintName="fk_day_goal_week"
                                 baseTableName="day_goal" baseColumnNames="week_goal_id"
                                 referencedTableName="week_goal" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
