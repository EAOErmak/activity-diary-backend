<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="v1_create_entry_template_metric_value" author="you">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="entry_template_metric_value"/>
            </not>
        </preConditions>

        <createTable tableName="entry_template_metric_value">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="template_metric_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="unit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="value" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_entry_template_metric_value_metric"
                baseTableName="entry_template_metric_value"
                baseColumnNames="template_metric_id"
                referencedTableName="entry_template_metric"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_entry_template_metric_value_unit"
                baseTableName="entry_template_metric_value"
                baseColumnNames="unit_id"
                referencedTableName="dictionary_item"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <addUniqueConstraint
                tableName="entry_template_metric_value"
                columnNames="template_metric_id,unit_id"
                constraintName="uk_entry_template_metric_value_unique_unit"/>

        <createIndex indexName="idx_entry_template_metric_value_metric" tableName="entry_template_metric_value">
            <column name="template_metric_id"/>
        </createIndex>

        <createIndex indexName="idx_entry_template_metric_value_unit" tableName="entry_template_metric_value">
            <column name="unit_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
