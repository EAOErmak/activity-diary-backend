# Copy this file to .env and replace placeholders with your local values.
# Keep profile selection outside this file unless you intentionally want a fixed profile.

# Optional: uncomment if you want a default local profile without IntelliJ setup.
# The imported .env file is parsed as a Spring properties file, so use property syntax here.
# spring.profiles.active=web
# spring.profiles.active=desktop

# Required for the default/base config and the web profile.
DB_URL=jdbc:postgresql://localhost:5432/activity_diary
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-characters
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# Optional safety toggle used by the base/web config.
APP_ADMIN_DATABASE_CLEAR_ENABLED=true

# Optional for the web profile.
APP_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:5174

#Do not fill
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REFRESH_TOKEN=change-me
GOOGLE_GMAIL_SENDER=no-reply@example.local

# Optional for the desktop profile.
# If omitted, the desktop profile uses ${user.home}/.activity-diary/activity-diary.db.
# APP_DB_PATH=C:/Users/your-user/.activity-diary/activity-diary.db
