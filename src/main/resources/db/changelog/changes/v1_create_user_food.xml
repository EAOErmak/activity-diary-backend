<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1-create-user-food" author="codex">
        <createTable tableName="user_food">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="dictionary_item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="protein" type="DECIMAL(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="fat" type="DECIMAL(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="carbs" type="DECIMAL(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="user_food"
                columnNames="user_id, dictionary_item_id"
                constraintName="uk_user_food_user_dictionary_item"/>

        <createIndex indexName="idx_user_food_user" tableName="user_food">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_user_food_dictionary_item" tableName="user_food">
            <column name="dictionary_item_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="user_food"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_food_user"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="user_food"
                baseColumnNames="dictionary_item_id"
                referencedTableName="dictionary_item"
                referencedColumnNames="id"
                constraintName="fk_user_food_dictionary_item"/>
    </changeSet>
</databaseChangeLog>
