<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1-47-create-tag-metric-link" author="diary">
        <createTable tableName="tag_metric_link">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="metric_name_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="tag_metric_link"
                columnNames="tag_id, metric_name_id"
                constraintName="uk_tag_metric_link_tag_metric_name"/>

        <createIndex indexName="idx_tag_metric_link_tag" tableName="tag_metric_link">
            <column name="tag_id"/>
        </createIndex>

        <createIndex indexName="idx_tag_metric_link_metric_name" tableName="tag_metric_link">
            <column name="metric_name_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="tag_metric_link"
                baseColumnNames="tag_id"
                referencedTableName="tag"
                referencedColumnNames="id"
                constraintName="fk_tag_metric_link_tag"/>

        <addForeignKeyConstraint
                baseTableName="tag_metric_link"
                baseColumnNames="metric_name_id"
                referencedTableName="dictionary_item"
                referencedColumnNames="id"
                constraintName="fk_tag_metric_link_metric_name"/>
    </changeSet>

</databaseChangeLog>
