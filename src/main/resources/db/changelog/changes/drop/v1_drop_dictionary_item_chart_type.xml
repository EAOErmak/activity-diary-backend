<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1-102-drop-dictionary-item-chart-type" author="diary">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="dictionary_item"/>
            <columnExists tableName="dictionary_item" columnName="chart_type"/>
        </preConditions>

        <dropColumn tableName="dictionary_item" columnName="chart_type"/>
    </changeSet>
</databaseChangeLog>
