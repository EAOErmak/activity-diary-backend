<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- PostgreSQL/web keeps the historical migration chain unchanged. -->
    <include file="db/changelog/postgres/db.postgres-master.xml" contextFilter="web"/>

    <!-- SQLite/desktop starts from a fresh baseline of the current schema. -->
    <include file="db/changelog/sqlite/db.sqlite-baseline.xml" contextFilter="desktop"/>

    <!-- Future shared changesets should stay database-agnostic. -->
    <include file="db/changelog/shared/db.shared-master.xml"/>
</databaseChangeLog>
