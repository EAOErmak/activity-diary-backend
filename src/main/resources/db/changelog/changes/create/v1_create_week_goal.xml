<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1_create_week_goal" author="you">
        <createTable tableName="week_goal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="when_started" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="when_ended" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="completeness" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <!-- BaseEntity поля (подстрой под свои названия, если отличаются) -->
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="week_goal" indexName="idx_week_goal_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="week_goal" indexName="idx_week_goal_range">
            <column name="when_started"/>
            <column name="when_ended"/>
        </createIndex>

        <addForeignKeyConstraint constraintName="fk_week_goal_user"
                                 baseTableName="week_goal" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
