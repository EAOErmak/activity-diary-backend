<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="v1_create_template_goal_metric" author="you">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="template_goal_metric"/>
            </not>
        </preConditions>

        <createTable tableName="template_goal_metric">
            <column name="template_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="metric_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sum_value" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="template_goal_metric"
                columnNames="template_id,metric_type_id,unit_id"
                constraintName="pk_template_goal_metric"/>

        <addForeignKeyConstraint
                constraintName="fk_template_goal_metric_template"
                baseTableName="template_goal_metric"
                baseColumnNames="template_id"
                referencedTableName="template"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_template_goal_metric_type"
                baseTableName="template_goal_metric"
                baseColumnNames="metric_type_id"
                referencedTableName="dictionary_item"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="fk_template_goal_metric_unit"
                baseTableName="template_goal_metric"
                baseColumnNames="unit_id"
                referencedTableName="dictionary_item"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <createIndex indexName="idx_template_goal_metric_template" tableName="template_goal_metric">
            <column name="template_id"/>
        </createIndex>

        <createIndex indexName="idx_template_goal_metric_type" tableName="template_goal_metric">
            <column name="metric_type_id"/>
        </createIndex>

        <createIndex indexName="idx_template_goal_metric_unit" tableName="template_goal_metric">
            <column name="unit_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
