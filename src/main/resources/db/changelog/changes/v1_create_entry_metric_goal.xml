<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1_create_entry_metric_goal" author="you">
        <createTable tableName="entry_metric_goal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="entry_goal_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="metric_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="entry_metric_goal"
                             constraintName="uk_metric_goal_entry_type"
                             columnNames="entry_goal_id,metric_type_id"/>

        <createIndex tableName="entry_metric_goal" indexName="idx_metric_goal_entry_goal">
            <column name="entry_goal_id"/>
        </createIndex>
        <createIndex tableName="entry_metric_goal" indexName="idx_metric_goal_type">
            <column name="metric_type_id"/>
        </createIndex>

        <addForeignKeyConstraint constraintName="fk_metric_goal_entry_goal"
                                 baseTableName="entry_metric_goal" baseColumnNames="entry_goal_id"
                                 referencedTableName="diary_entry_goal" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint constraintName="fk_metric_goal_type"
                                 baseTableName="entry_metric_goal" baseColumnNames="metric_type_id"
                                 referencedTableName="dictionary_item" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="v2_entry_metric_goal_allow_duplicates_by_type" author="you">
        <!-- 1) drop old unique constraint -->
        <dropUniqueConstraint
                tableName="entry_metric_goal"
                constraintName="uk_metric_goal_entry_type"/>

        <!-- 2) add position -->
        <addColumn tableName="entry_metric_goal">
            <column name="position" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- 3) backfill: всем старым поставить position=1 -->
        <update tableName="entry_metric_goal">
            <column name="position" valueNumeric="1"/>
            <where>position is null</where>
        </update>

        <!-- 4) make not null -->
        <addNotNullConstraint tableName="entry_metric_goal" columnName="position" columnDataType="INT"/>

        <!-- 5) new unique -->
        <addUniqueConstraint
                tableName="entry_metric_goal"
                constraintName="uk_metric_goal_entry_pos"
                columnNames="entry_goal_id,position"/>

        <!-- 6) optional index -->
        <createIndex tableName="entry_metric_goal" indexName="idx_metric_goal_entry_pos">
            <column name="entry_goal_id"/>
            <column name="position"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
