<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="v1-101-drop-legacy-telegram-accounts" author="diary">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user_accounts"/>
            <columnExists tableName="user_accounts" columnName="provider"/>
        </preConditions>

        <delete tableName="user_accounts">
            <where>provider IN ('TELEGRAMM', 'TELEGRAM')</where>
        </delete>
    </changeSet>
</databaseChangeLog>
